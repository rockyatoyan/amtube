  "nx": {
    "targets": {
      "server:prod": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            {
              "command": "docker-compose -f docker-compose.prod.yml up --build -d"
            },
            {
              "command": "npx nx run-many --target=build --projects=@amtube/server"
            },
            {
              "command": "npx nx run @amtube/server:predeploy"
            },
            {
              "command": "npx nx run @amtube/server:serve:production"
            }
          ],
          "parallel": false
        }
      },
      "client:prod": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            {
              "command": "nx run-many --target=build --projects=@amtube/client"
            },
            {
              "command": "npx nx run @amtube/client:start"
            }
          ],
          "parallel": false
        }
      }
    }
  }
}
