{
  "name": "@amtube/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npx nx serve @amtube/server --no-tui",
    "dev:up": "docker-compose -f docker-compose.dev.yml up  -d db_dev && npm run redis:up",
    "prisma:generate": "npx prisma generate",
    "migrate:prod": "npx prisma migrate deploy",
    "redis:up": "docker-compose -f docker-compose.dev.yml up -d redis",
    "test:up": "docker-compose -f docker-compose.dev.yml up -d db_test && npm run redis:up && npm run test:reset",
    "test:down": "docker-compose -f docker-compose.dev.yml stop db_test && docker-compose -f docker-compose.dev.yml stop redis",
    "test:reset": "env-cmd -f .env.test prisma migrate reset --force && env-cmd -f .env.test prisma migrate deploy",
    "test": "npm run test:up && env-cmd -f .env.test jest --config ./test/jest-e2e.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/server"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/dist/apps/server/package.json",
          "{workspaceRoot}/dist/apps/server/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/dist/apps/server/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@amtube/server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@amtube/server:build:development"
          },
          "production": {
            "buildTarget": "@amtube/server:build:production"
          }
        }
      },
      "dev-with-services": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/server",
          "commands": [
            {
              "command": "npm run dev:up"
            },
            {
              "command": "npx prisma generate"
            },
            {
              "command": "npx prisma migrate dev"
            },
            {
              "command": "nx serve @amtube/server --no-tui"
            }
          ],
          "parallel": false
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "predeploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/server",
          "commands": [
            "npm run prisma:generate",
            "npm run migrate:prod"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/websockets": "^11.0.12",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/bcrypt": "^5.0.2",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.44.3",
    "cache-manager": "^6.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jose": "^6.0.10",
    "js-cookie": "^3.0.5",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "yup": "^1.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "prisma": "^7.2.0"
  }
}
